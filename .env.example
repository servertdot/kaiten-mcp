# Required. Create it in Kaiten under Profile -> API key.
KAITEN_TOKEN=

# Required. Kaiten API origin or full API base URL for your company instance.
# Example: https://your-company.kaiten.ru/api/v1
KAITEN_BASE_URL=

# Optional defaults and safety boundaries. KAITEN_SPACE_ID remains supported
# as a legacy single-space shortcut.
KAITEN_SPACE_IDS=
KAITEN_DEFAULT_SPACE_ID=
KAITEN_DEFAULT_OWNER_ID=
KAITEN_EXPECTED_ACTOR_ID=
KAITEN_ALLOWED_BOARD_IDS=
KAITEN_FILE_HOSTS=
KAITEN_MAX_ATTACHMENT_BYTES=5242880

# Optional smoke helpers
# KAITEN_SMOKE_CARD=PROJ-123
# KAITEN_SMOKE_SPACE_ID=123
# KAITEN_SMOKE_TARGET_COLUMN_ID=456
# KAITEN_SMOKE_CUSTOM_PROPERTY_ID=789
# KAITEN_SMOKE_CUSTOM_PROPERTY_NAME=DoD
